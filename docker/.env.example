# Project Name
COMPOSE_PROJECT_NAME=super-agent

# Server Configuration
WEB_PORT=80

FASTIFY_MULTIPART_FILE_SIZE_MB=100

# Database Configuration
# Using 'db' as hostname since it's on the same docker network
DATABASE_URL="postgres://postgres:postgrespassword@db:5432/ai_agent"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=ai_agent

# JWT Configuration
JWT_SECRET="supersecretkey"

# Dify API Configuration
DIFY_BASE_URL="https://api.dify.ai/v1"
DIFY_SUPER_AGENT_API_KEY="your-dify-api-key"
DIFY_KNOWLEDGE_API_KEY="your-dify-knowledge-api-key"
