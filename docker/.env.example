# Project Name
COMPOSE_PROJECT_NAME=super-agent

# Server Configuration
WEB_PORT=80

FASTIFY_MULTIPART_FILE_SIZE_MB=100

# User Configuration
INITIAL_BALANCE=100

# Database Configuration
# Using 'db' as hostname since it's on the same docker network
DATABASE_URL="postgres://postgres:postgrespassword@db:5432/ai_agent"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=ai_agent

# MinIO AIStor Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=super-agent
# In production, this must be the public URL (e.g. http://your-domain.com:9000) accessible by users' browsers
MINIO_PUBLIC_URL=http://localhost:9000

# JWT Configuration
JWT_SECRET="supersecretkey"

# Dify API Configuration
DIFY_BASE_URL="https://api.dify.ai/v1"
DIFY_SUPER_AGENT_CHAT_API_KEY="your-dify-api-key"
DIFY_KNOWLEDGE_API_KEY="your-dify-knowledge-api-key"
