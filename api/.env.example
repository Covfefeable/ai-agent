# Server Configuration
PORT=3000

FASTIFY_MULTIPART_FILE_SIZE_MB=100

# Database Configuration
DATABASE_URL="postgres://postgres:postgrespassword@localhost:5432/ai_agent"

# JWT Configuration
JWT_SECRET="supersecretkey"

# User Configuration
INITIAL_BALANCE=100

# Dify API Configuration
DIFY_BASE_URL="https://api.dify.ai/v1"
DIFY_SUPER_AGENT_CHAT_API_KEY="your-dify-api-key"
DIFY_KNOWLEDGE_API_KEY="your-dify-knowledge-api-key"

# MinIO Configuration
# In Docker environment, use service name 'minio' for internal communication
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ai-agent-app
MINIO_SECRET_KEY=ai-agent-secret-key
MINIO_BUCKET_NAME=super-agent


